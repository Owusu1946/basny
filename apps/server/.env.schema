# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Hosting platform injects the HTTP port for the persistent API service.
# @optional @public @type=string(minLength=1)
PORT=

# Render injects the public URL for this Web Service. Used by the optional self-ping keep-alive.
# @optional @public @type=url
RENDER_EXTERNAL_URL=

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public auth URL used in verification links and redirects.
# @public @type=url
BETTER_AUTH_URL=

# This origin is emitted in Access-Control-Allow-Origin; it is public and must not be scanned as a secret.
# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Real-time service secret. Leave empty only during UI development; live updates require an Ably API key.
# @optional @sensitive @type=string(minLength=1)
ABLY_API_KEY=

# Transactional email used by account verification and password recovery.
# @optional @sensitive @type=string(minLength=1)
RESEND_API_KEY=

# Sender must be verified in Resend before email can be delivered.
# @optional @type=string(minLength=3)
RESEND_FROM_EMAIL=

# Paystack secret keys are server-only. Database-managed keys require a stable 32+ character encryption key.
# @optional @sensitive @type=string(minLength=1)
PAYSTACK_SECRET_KEY=

# The Paystack public key is designed to be shared with clients; only the secret key stays private.
# @optional @public @type=string(minLength=1)
PAYSTACK_PUBLIC_KEY=

# @optional @sensitive @type=string(minLength=32)
PAYSTACK_CONFIG_ENCRYPTION_KEY=

# Public Neon Object Storage location identifiers. These are part of public-read image URLs, not credentials.
# @optional @public @type=url
AWS_ENDPOINT_URL_S3=
# @optional @sensitive @type=string(minLength=1)
AWS_ACCESS_KEY_ID=
# @optional @sensitive @type=string(minLength=1)
AWS_SECRET_ACCESS_KEY=
# @optional @public @type=string(minLength=1)
AWS_REGION=
# @optional @public @type=string(minLength=1)
NEON_OBJECT_STORAGE_BUCKET=

# Optional Vercel route used to invalidate the tagged public catalogue cache.
# @optional @type=url
CATALOGUE_REVALIDATE_URL=
# @optional @sensitive @type=string(minLength=32)
CATALOGUE_REVALIDATE_SECRET=

# Opt-in guard for the one-time development/preview sample catalogue command.
# @optional @public @type=boolean
ALLOW_CATALOGUE_SEED=
