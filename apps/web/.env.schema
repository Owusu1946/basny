# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Backend upstream for same-origin API rewrites and server-rendered requests.
# Keep this set to the Render URL, not the storefront URL.
# @public @type=url
NEXT_PUBLIC_SERVER_URL=

# Shared only with the API service to authorize on-demand catalogue cache invalidation.
# @optional @sensitive @type=string(minLength=32)
CATALOGUE_REVALIDATE_SECRET=
